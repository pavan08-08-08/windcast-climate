# Copy to .env (which is gitignored) and change if needed.
POSTGRES_USER=windcast
POSTGRES_PASSWORD=windcast_dev
POSTGRES_DB=windcast
# If you already run Postgres locally on 5432, set this to 5433 AND change the port in DATABASE_URL below to match.
DB_HOST_PORT=5432

# Connection string for Python code (ETL, models, dashboard)
DATABASE_URL=postgresql://windcast:windcast_dev@localhost:5432/windcast
